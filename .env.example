# Configuração central de variáveis de ambiente para o Wartune Reborn
# Copie para .env e ajuste para o ambiente alvo (VPS / Hostinger / EasyPanel)

# -----------------------------------------------------------------------------
# DOMÍNIOS E ENDEREÇOS PÚBLICOS
# Em produção na VPS, configure os domínios reais apontando para a máquina:
# Ex:
# WARTUNE_PUBLIC_HOST=game.seudominio.com (ou o IP público da VPS para o socket TCP)
# WARTUNE_PORTAL_URL=https://portal.seudominio.com/portal/
# WARTUNE_CDN_URL=https://cdn.seudominio.com/cdn/
# WARTUNE_GAME_URL=https://cdn.seudominio.com/game/
# -----------------------------------------------------------------------------
WARTUNE_PUBLIC_HOST=127.0.0.1
WARTUNE_PORTAL_URL=http://127.0.0.1:8090/portal/
WARTUNE_CDN_URL=http://127.0.0.1:8081/cdn/
WARTUNE_GAME_URL=http://127.0.0.1:8081/game/

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=wartune
POSTGRES_USER=wartune
POSTGRES_PASSWORD=troque_esta_senha_em_producao_2026

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DO SERVIDOR DE JOGO
# -----------------------------------------------------------------------------
WARTUNE_SERVER_ID=1
WARTUNE_SERVER_NAME=S1 - Wartune Reborn
WARTUNE_SITE=local_0001
WARTUNE_GAME_TIMEZONE=UTC
WARTUNE_SKIP_TUTORIAL=false

# Segredo de comunicação entre Painel GM do Portal e Servidor Python (/gm/kick e /gm/ban)
WARTUNE_GM_SECRET=defina_um_segredo_forte_para_gm

# Usuários que terão acesso ao Painel GM no portal (separados por vírgula)
WARTUNE_GM_USERS=admin
